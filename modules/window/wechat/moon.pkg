import {
  "wzzc-dev/window/core",
  "wzzc-dev/window/dpi",
}

supported_targets = "wasm-gc+wasm"

options(
  link: {
    "wasm-gc": {
      "exports": [
        "wechat_dispatch_event",
        "wechat_dispatch_pointer_input",
        "wechat_render_frame",
        "wechat_surface_created",
        "wechat_surface_destroyed",
        "wechat_app_show",
        "wechat_app_hide",
      ],
    },
    "wasm": {
      "exports": [
        "wechat_dispatch_event",
        "wechat_dispatch_pointer_input",
        "wechat_render_frame",
        "wechat_surface_created",
        "wechat_surface_destroyed",
        "wechat_app_show",
        "wechat_app_hide",
      ],
    },
  },
  targets: { },
)
