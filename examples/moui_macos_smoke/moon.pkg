import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "wzzc-dev/window/core",
  "wzzc-dev/window/dpi",
  "wzzc-dev/window/examples/util",
  "wzzc-dev/window/macos",
  "wzzc-dev/window/windowing",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "input_native.m" ],
  link: {
    "native": {
      "cc-link-flags": "-framework AppKit -framework Foundation -lobjc",
    },
  },
  targets: { "main.mbt": [ "native" ] },
)
